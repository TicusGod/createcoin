VITE_SOLANA_NETWORK=mainnet-beta

# The public /api/rpc proxy intentionally uses public Solana RPC endpoints.
# Do not point a public browser-facing proxy at a paid Helius/QuickNode URL.

# Raydium cluster follows VITE_SOLANA_NETWORK automatically (do not set VITE_RAYDIUM_CLUSTER unless it matches).

# Optional server-only Bearer for Pump APIs:
PUMPFUN_AUTH=

# Server-only upload secret for Pinata:
PINATA_JWT=
VITE_PINATA_GATEWAY=https://gateway.pinata.cloud

VITE_PLATFORM_TREASURY_MAINNET=
VITE_PLATFORM_TREASURY_DEVNET=

# Optional — comma or space separated wallet addresses that pay no platform SOL fees (token create, Raydium add/remove pool tip, boost payment, copy trending).
# Same list uses Meteora DAMM v2 “Create Pool” (memecoin / SOL) instead of Raydium; pools are stored in localStorage only.
# VITE_FEE_EXEMPT_WALLETS=

VITE_FEE_TOKEN_CREATION_SOL=0.1
VITE_FEE_MODIFY_CREATOR_SOL=0.1
VITE_FEE_COPY_TRENDING_SOL=0.5
VITE_FEE_ADD_LIQUIDITY_SOL=0.1
VITE_FEE_REMOVE_LIQUIDITY_SOL=0.1
VITE_FEE_DEX_BOOST_SOL=0.25
VITE_FEE_REVOKE_MINT_SOL=0.05
VITE_FEE_REVOKE_FREEZE_SOL=0.05
VITE_FEE_REVOKE_UPDATE_SOL=0.05

VITE_WSOL_MINT=So11111111111111111111111111111111111111112
VITE_USDC_MINT_MAINNET=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
VITE_USDC_MINT_DEVNET=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

PRICE_API=https://api.jup.ag/price/v3
# Optional server-only Jupiter API key for production `/price/v3` usage:
# JUPITER_PRICE_API_KEY=

# Supabase (optional): unused in-app after removing demo `public.pools`; keep only if you add auth or other tables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

VITE_AXIOM_URL=http://localhost:3000

# --- Private recording-mode bypass (middleware.ts) -------------------------
# High-entropy secret owned by the site operator. Visiting
#   https://coincreate.fun/?recording_key=<value>
# from the operator's browser exchanges it for an HttpOnly HMAC cookie that
# suppresses the coincreate.fun → coincreate.co 307 for that browser only.
# Server-side only — NEVER prefix with VITE_ / NEXT_PUBLIC_ and never log it.
# Generate with e.g. `openssl rand -hex 32` and store it in the Vercel
# environment (Production + Preview scopes) — not in this file.
RECORDING_BYPASS_SECRET=

# Optional override for the redirect target that non-recording visitors are
# sent to. Defaults to https://coincreate.co when unset.
# RECORDING_REDIRECT_TARGET=https://coincreate.co

